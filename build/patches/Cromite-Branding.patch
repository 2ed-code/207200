From: 2ed-code <2ed-code@users.noreply.github.com>
Date: Thu, 17 Sep 2026 11:15:00 +0000
Subject: Replace visible Cromite flags branding

Replace the visible Cromite product reference in the settings shortcut with
207200 branding. The internal feature/namespace names are intentionally left
unchanged because they are implementation details used by the existing patch
set.

License: GPL-2.0-or-later - https://spdx.org/licenses/GPL-2.0-or-later.html
---
 chrome/android/java/res/values/values.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/chrome/android/java/res/values/values.xml b/chrome/android/java/res/values/values.xml
--- a/chrome/android/java/res/values/values.xml
+++ b/chrome/android/java/res/values/values.xml
@@ -40,7 +40,7 @@ found in the LICENSE file.
     <!-- Contextual Search -->
     <item name="contextual_search_sheet_full_height_fraction" format="float" type="dimen">0.95</item>
 
-    <string name="cromite_flags_title">Open Cromite flags list</string>
+    <string name="cromite_flags_title">Open 207200 flags list</string>
     <string name="cromite_flags_url">chrome://flags/cromite</string>
 
--
